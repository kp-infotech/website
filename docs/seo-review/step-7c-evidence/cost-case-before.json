      "style": "normal"
    },
    {
      "_key": "ff3569a800a2",
      "_type": "richText",
      "children": [
        {
          "_key": "54eb2a858159",
          "_type": "span",
          "marks": [],
          "text": "4. AWS S3 Storage Optimization"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "e8b0d0607c3a",
      "_type": "richText",
      "children": [
        {
          "_key": "cf4036ea5e18",
          "_type": "span",
          "marks": [],
          "text": "AWS storage was one of the key areas of hidden waste. We implemented S3 lifecycle policies, intelligent tiering, and cleanup rules to move older or less frequently accessed files into more cost-effective storage classes."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "f22b8b4326aa",
      "_type": "richText",
      "children": [
        {
          "_key": "36ddb9e0295e",
          "_type": "span",
          "marks": [],
          "text": "This helped reduce AWS cost while keeping the required data accessible and secure."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c1a1b9bbe7fc",
      "_type": "richText",
      "children": [
        {
          "_key": "35c9e7e71376",
