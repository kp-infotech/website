  "approach": [
    {
      "_key": "f651e087b55b",
      "_type": "richText",
      "children": [
        {
          "_key": "fb24aacfc629",
          "_type": "span",
          "marks": [],
          "text": "KP Infotech started with a complete infrastructure audit instead of immediately suggesting a migration. The goal was to understand where the money was going, which resources were business-critical, and which parts of the setup were unnecessary or oversized."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "1b495cb07c45",
      "_type": "richText",
      "children": [
        {
          "_key": "cf5bebc35613",
          "_type": "span",
          "marks": [],
          "text": "The work was handled in four major phases."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c1ebd0787b4c",
      "_type": "richText",
      "children": [
        {
          "_key": "5b18902c7620",
          "_type": "span",
          "marks": [],
          "text": "1. Cloud Cost Audit"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "92cc04cb1a55",
      "_type": "richText",
      "children": [
        {
          "_key": "ed91d3d9906f",
          "_type": "span",
          "marks": [],
          "text": "We reviewed the existing AWS and DigitalOcean usage, including compute, storage, backups, inactive resources, deployment flow, and monthly billing patterns."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "c377b812cb6d",
      "_type": "richText",
      "children": [
        {
          "_key": "f1e7f9c4561d",
          "_type": "span",
          "marks": [],
          "text": "This helped us identify the biggest cost drivers:"
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
