      "_type": "richText",
      "children": [
        {
          "_key": "258b5a20ce9e",
          "_type": "span",
          "marks": [],
          "text": "We containerized the application environment using Docker and introduced Coolify to manage deployments more cleanly."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
