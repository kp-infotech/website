          "name": "Business Automation",
          "description": "Automate workflows, approvals, reporting, documents and system handoffs with practical business automation built around your operations.",
          "url": "https://kpinfo.tech/services/business-automation/",
          "provider": {
            "@id": "https://kpinfo.tech/#organization"
          },
          "serviceType": "Business Automation",
