---
// ScrollProgress.astro
// Fixed 2px accent-colored bar at top of viewport showing scroll progress.
// Hidden when page content fits within viewport (no scroll needed).
// Respects prefers-reduced-motion by hiding entirely via CSS.
// Re-initializes on Astro view transitions (astro:after-swap).
---

<div id="scroll-progress" class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress__bar"></div>
</div>

<style>
  .scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    z-index: 9999;
    pointer-events: none;
    /* Hidden by default — shown only when page is scrollable */
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .scroll-progress--visible {
    opacity: 1;
  }

  .scroll-progress__bar {
    height: 100%;
    width: 0%;
    background-color: var(--accent);
    /* No background track — parent is transparent */
    will-change: width;
  }

  /* Respect prefers-reduced-motion: hide entirely */
  @media (prefers-reduced-motion: reduce) {
    .scroll-progress {
      display: none;
    }
  }
</style>

<script>
  function initScrollProgress() {
    const container = document.getElementById('scroll-progress');
    if (!container) return;

    const bar = container.querySelector<HTMLElement>('.scroll-progress__bar');
    if (!bar) return;

    let rafPending = false;

    function update() {
      rafPending = false;

      const scrollY = window.scrollY;
      const documentHeight = document.documentElement.scrollHeight;
      const viewportHeight = window.innerHeight;
      const scrollableHeight = documentHeight - viewportHeight;

      // Hide when page content fits within viewport (nothing to scroll)
      if (scrollableHeight <= 0) {
        container.classList.remove('scroll-progress--visible');
        bar.style.width = '0%';
        return;
      }

      container.classList.add('scroll-progress--visible');

      const progress = Math.min(scrollY / scrollableHeight, 1);
      bar.style.width = `${progress * 100}%`;
    }

    function onScroll() {
      // Throttle with requestAnimationFrame — only one update per frame
      if (!rafPending) {
        rafPending = true;
        requestAnimationFrame(update);
      }
    }

    // Initial paint
    update();

    window.addEventListener('scroll', onScroll, { passive: true });

    // Cleanup: return a function that removes the listener
    return () => {
      window.removeEventListener('scroll', onScroll);
    };
  }

  // Track cleanup across navigations
  let cleanup: (() => void) | undefined;

  function mount() {
    if (cleanup) cleanup();
    cleanup = initScrollProgress();
  }

  // First load
  mount();

  // Re-initialize after Astro view transitions swap the DOM
  document.addEventListener('astro:after-swap', mount);
</script>
