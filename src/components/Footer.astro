---
import { Icon } from 'astro-icon/components';
import { urlFor, isSvgAsset } from '../lib/sanity';
import type { SanityImageSource } from '@sanity/image-url/lib/types/types';

interface SocialLinks {
  linkedin?: string;
  twitter?: string;
  instagram?: string;
  dribbble?: string;
  facebook?: string;
}

interface Props {
  siteName?: string;
  logo?: SanityImageSource;
  footerText?: string;
  contactEmail?: string;
  contactPhone?: string;
  address?: string;
  socialLinks?: SocialLinks;
}

const {
  siteName = 'KP Infotech',
  logo,
  footerText = 'Crafting digital experiences that elevate brands and drive measurable business growth.',
  contactEmail = 'hello@kpinfo.tech',
  contactPhone,
  address = 'Ahmedabad, India',
  socialLinks = {},
} = Astro.props;

// Get logo URL - same logic as Navigation
const logoUrl = logo
  ? isSvgAsset(logo)
    ? urlFor(logo).url()
    : urlFor(logo).height(120).format('webp').url()
  : null;

const currentYear = new Date().getFullYear();

const services = [
  { name: 'UI/UX Design', href: '/services/ui-ux-design/' },
  { name: 'Web Development', href: '/services/web-development/' },
  { name: 'Mobile Apps', href: '/services/mobile-apps/' },
  { name: 'ERP Solutions', href: '/services/erp-solutions/' },
  { name: 'Digital Marketing', href: '/services/digital-marketing/' },
];

const company = [
  { name: 'About', href: '/about/' },
  { name: 'Work', href: '/work/' },
  { name: 'Careers', href: '/careers/' },
  { name: 'Insights', href: '/insights/' },
  { name: 'Contact', href: '/contact/' },
];

const industries = [
  { name: 'Healthcare', href: '/industries/healthcare/' },
  { name: 'Retail & E-commerce', href: '/industries/retail-ecommerce/' },
  { name: 'Manufacturing', href: '/industries/manufacturing/' },
  { name: 'Logistics', href: '/industries/logistics/' },
  { name: 'Finance', href: '/industries/finance/' },
  { name: 'Startups', href: '/industries/startups/' },
];

// Build socials array from siteSettings
const socials = [
  socialLinks?.linkedin && { name: 'LinkedIn', href: socialLinks.linkedin, icon: 'fa6-brands:linkedin-in' },
  socialLinks?.twitter && { name: 'X', href: socialLinks.twitter, icon: 'fa6-brands:x-twitter' },
  socialLinks?.instagram && { name: 'Instagram', href: socialLinks.instagram, icon: 'fa6-brands:instagram' },
  socialLinks?.facebook && { name: 'Facebook', href: socialLinks.facebook, icon: 'fa6-brands:facebook-f' },
  socialLinks?.dribbble && { name: 'Dribbble', href: socialLinks.dribbble, icon: 'fa6-brands:dribbble' },
].filter(Boolean) as Array<{ name: string; href: string; icon: string }>;
---

<footer class="bg-[var(--bg-secondary)] border-t border-[var(--border)]">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12 py-16 lg:py-20">
    <!-- Main Footer Grid -->
    <div class="footer-grid">
      <!-- Column 1: Logo + Tagline + Social -->
      <div class="footer-brand">
        <a href="/" class="inline-block mb-6" aria-label={`${siteName} - Home`}>
          {logoUrl ? (
            <img
              src={logoUrl}
              alt={siteName}
              class="footer-logo"
            />
          ) : (
            <span class="font-playfair text-2xl font-medium text-[var(--text-primary)]">
              {siteName}
            </span>
          )}
        </a>
        <p class="text-[var(--text-secondary)] text-sm leading-relaxed mb-8 max-w-xs">
          {footerText}
        </p>
        {socials.length > 0 && (
          <div class="flex items-center gap-4">
            {socials.map((social) => (
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors duration-300"
                aria-label={social.name}
              >
                <Icon name={social.icon} size={20} />
              </a>
            ))}
          </div>
        )}
      </div>

      <!-- Column 2: Services -->
      <nav aria-label="Services">
        <h3 class="footer-label">Services</h3>
        <ul class="space-y-3">
          {services.map((service) => (
            <li>
              <a
                href={service.href}
                class="footer-nav-link text-[var(--text-secondary)] text-sm"
              >
                <span class="footer-link__letters">
                  {service.name.split('').map((char: string, i: number) => (
                    <span class="footer-link__letter" style={`--letter-i: ${i}`}>
                      {char === ' ' ? '\u00A0' : char}
                    </span>
                  ))}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Column 3: Company + Industries -->
      <div class="footer-double-col">
        <nav aria-label="Company">
          <h3 class="footer-label">Company</h3>
          <ul class="space-y-3">
            {company.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-nav-link text-[var(--text-secondary)] text-sm"
                >
                  <span class="footer-link__letters">
                    {link.name.split('').map((char: string, i: number) => (
                      <span class="footer-link__letter" style={`--letter-i: ${i}`}>
                        {char === ' ' ? '\u00A0' : char}
                      </span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Industries">
          <h3 class="footer-label">Industries</h3>
          <ul class="space-y-3">
            {industries.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="footer-nav-link text-[var(--text-secondary)] text-sm"
                >
                  <span class="footer-link__letters">
                    {link.name.split('').map((char: string, i: number) => (
                      <span class="footer-link__letter" style={`--letter-i: ${i}`}>
                        {char === ' ' ? '\u00A0' : char}
                      </span>
                    ))}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>

      <!-- Column 4: Contact -->
      <div>
        <h3 class="footer-label">Contact</h3>
        <address class="not-italic space-y-4">
          {contactEmail && (
            <a
              href={`mailto:${contactEmail}`}
              class="footer-contact-link"
            >
              <Icon name="fa6-solid:envelope" size={15} class="footer-contact-icon" />
              <span>{contactEmail}</span>
            </a>
          )}
          {contactPhone && (
            <a
              href={`tel:${contactPhone.replace(/\s/g, '')}`}
              class="footer-contact-link"
            >
              <Icon name="fa6-solid:phone" size={15} class="footer-contact-icon" />
              <span>{contactPhone}</span>
            </a>
          )}
          {address && (
            <div class="footer-contact-link footer-contact-link--static">
              <Icon name="fa6-solid:location-dot" size={15} class="footer-contact-icon" />
              <span class="whitespace-pre-line">{address}</span>
            </div>
          )}
        </address>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-16 pt-8 border-t border-[var(--border)]">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <p class="text-[var(--text-secondary)] text-xs">
          &copy; {currentYear} {siteName}. All rights reserved.
        </p>
        <nav class="flex items-center gap-6" aria-label="Legal">
          <a
            href="/privacy-policy/"
            class="text-[var(--text-secondary)] hover:text-[var(--accent)] text-xs transition-colors duration-300"
          >
            Privacy Policy
          </a>
          <a
            href="/terms-of-service/"
            class="text-[var(--text-secondary)] hover:text-[var(--accent)] text-xs transition-colors duration-300"
          >
            Terms of Service
          </a>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-logo {
    height: 80px;
    width: auto;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  .footer-label {
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 4px;
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .footer-nav-link {
    display: inline-block;
    text-decoration: none;
  }

  .footer-link__letters {
    display: inline-flex;
  }

  .footer-link__letter {
    display: inline-block;
    transition:
      transform 0.3s calc(var(--letter-i) * 0.025s) cubic-bezier(0.25, 0.1, 0.25, 1),
      color 0.3s calc(var(--letter-i) * 0.025s);
  }

  .footer-nav-link:hover .footer-link__letter {
    transform: translateY(-2px);
    color: var(--accent);
  }

  .footer-double-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .footer-contact-link {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    color: var(--text-secondary);
    font-size: 0.875rem;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .footer-contact-link:hover {
    color: var(--accent);
  }

  .footer-contact-link--static {
    cursor: default;
  }

  .footer-contact-link--static:hover {
    color: var(--text-secondary);
  }

  .footer-contact-icon {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--accent);
    opacity: 0.6;
  }

  /* Tablet: 2 columns */
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* Desktop: 4 columns — brand wider */
  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1.5fr 1fr;
      gap: 2rem;
    }
  }
</style>
