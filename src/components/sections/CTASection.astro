---
import Button from '../ui/Button.astro';
import HighlightedText from '../ui/HighlightedText.astro';

interface Props {
  headline?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  event?: string;
  location?: string;
  serviceSlug?: string;
  caseStudySlug?: string;
}

const {
  headline = "Ready to Replace Manual Work With Better Systems?",
  description = "Tell us where your operations are slowing down. We’ll help you plan the right mix of custom software, ERP, automation, AI, and cloud infrastructure.",
  buttonText = "Discuss Your Operations Challenge",
  buttonHref = "/contact/",
  event = 'cta',
  location = 'cta_section',
  serviceSlug,
  caseStudySlug,
} = Astro.props;
---

<section class="cta-section">
  <div class="cta-section__container site-container">
    <div class="cta-section__card" data-reveal="clip">
      <h2 class="cta-section__headline"><HighlightedText text={headline} /></h2>
      <p class="cta-section__description">{description}</p>
      <Button
        variant="primary"
        href={buttonHref}
        data-cta={event}
        data-location={location}
        data-label={buttonText}
        data-service={serviceSlug}
        data-case-study={caseStudySlug}
      >
        {buttonText}
      </Button>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 6rem 0;
    background: var(--bg-primary);
  }

  .cta-section__card {
    padding: 5rem 4rem;
    background: var(--bg-secondary);
    border: 1px solid var(--accent);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cta-section__headline {
    font-family: var(--font-display), 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-primary);
    margin: 0 0 1.5rem;
  }

  .cta-section__description {
    font-family: var(--font-body), 'Outfit', sans-serif;
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 500px;
    margin: 0 0 2.5rem;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .cta-section {
      padding: 4rem 0;
    }

    .cta-section__card {
      padding: 3rem 2rem;
    }

    .cta-section__headline {
      font-size: clamp(1.75rem, 5vw, 2.25rem);
    }

    .cta-section__description {
      font-size: 1rem;
    }
  }

  @media (max-width: 480px) {
    .cta-section__card {
      padding: 2.5rem 1.5rem;
    }
  }

</style>
