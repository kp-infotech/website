---
import PageHero from './PageHero.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import HighlightedText from '../ui/HighlightedText.astro';

interface Props {
  label?: string;
  headline?: string;
  description?: string;
  image?: string;
}

const {
  label = "About Us",
  headline = "Who We Are",
  description = "A premium digital product studio crafting exceptional experiences for ambitious brands.",
  image,
} = Astro.props;
---

<PageHero
  variant="inner"
  image={image}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'About' },
  ]}
>
  <SectionLabel text={label} />

  <h1>
    <HighlightedText text={headline} />
  </h1>

  <p class="page-hero__description">{description}</p>
</PageHero>
