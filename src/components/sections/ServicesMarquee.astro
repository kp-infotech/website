---
/**
 * Tech Stack Marquee
 * Displays technology logos with brand colors using simple-icons.
 * Accepts an array of simple-icons slugs (e.g. "react", "nodedotjs", "figma").
 * See full list at https://simpleicons.org/
 */
import * as simpleIcons from 'simple-icons';

interface Props {
  /** Array of simple-icons slugs */
  techSlugs?: string[];
}

const {
  techSlugs = [
    // AI & ML tools first
    'claude', 'googlegemini', 'openrouter',
    'elevenlabs', 'huggingface', 'ollama', 'replicate',
    'tensorflow', 'pytorch', 'langchain',
    // Core dev stack
    'react', 'nodedotjs', 'nextdotjs', 'typescript',
    'tailwindcss', 'figma', 'python', 'flutter',
    'postgresql', 'mongodb', 'docker', 'git',
    'supabase', 'firebase', 'cloudflare', 'sanity',
  ],
} = Astro.props;

// Build icon data from simple-icons
interface TechIcon {
  title: string;
  svg: string;
  brandColor: string;
}

/**
 * Some brand colors are too dark to see on our #0a0a0a background.
 * Lighten those to white.
 */
function getVisibleColor(hex: string): string {
  const r = parseInt(hex.slice(0, 2), 16);
  const g = parseInt(hex.slice(2, 4), 16);
  const b = parseInt(hex.slice(4, 6), 16);
  // Relative luminance check — if too dark, use white
  const luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
  return luminance < 0.15 ? 'ffffff' : hex;
}

const techIcons: TechIcon[] = [];

for (const slug of techSlugs) {
  const key = 'si' + slug.charAt(0).toUpperCase() + slug.slice(1);
  const icon = (simpleIcons as Record<string, any>)[key];
  if (icon) {
    techIcons.push({
      title: icon.title,
      svg: icon.svg,
      brandColor: getVisibleColor(icon.hex),
    });
  }
}
---

{techIcons.length > 0 && (
  <section class="tech-marquee" aria-label={`Technologies: ${techIcons.map(i => i.title).join(', ')}`}>
    <div class="tech-marquee__track">
      <div class="tech-marquee__group">
        {techIcons.map((icon) => (
          <Fragment>
            <span
              class="tech-marquee__item"
              title={icon.title}
              style={`--brand-color: #${icon.brandColor};`}
            >
              <Fragment set:html={icon.svg} />
              <span class="tech-marquee__label">{icon.title}</span>
            </span>
            <span class="tech-marquee__dot" aria-hidden="true"></span>
          </Fragment>
        ))}
      </div>
      <div class="tech-marquee__group" aria-hidden="true">
        {techIcons.map((icon) => (
          <Fragment>
            <span
              class="tech-marquee__item"
              title={icon.title}
              style={`--brand-color: #${icon.brandColor};`}
            >
              <Fragment set:html={icon.svg} />
              <span class="tech-marquee__label">{icon.title}</span>
            </span>
            <span class="tech-marquee__dot" aria-hidden="true"></span>
          </Fragment>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .tech-marquee {
    padding: 2.5rem 0;
    background: var(--bg-primary);
    overflow: hidden;
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 10%,
      black 90%,
      transparent 100%
    );
  }

  .tech-marquee__track {
    display: flex;
    animation: tech-scroll 45s linear infinite;
  }

  .tech-marquee:hover .tech-marquee__track {
    animation-play-state: paused;
  }

  .tech-marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 5rem;
    padding-right: 5rem;
  }

  .tech-marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    cursor: default;
    white-space: nowrap;
  }

  .tech-marquee__item :global(svg) {
    width: 96px;
    height: 96px;
    fill: var(--brand-color);
    opacity: 0.35;
    transition: opacity 0.3s ease;
    flex-shrink: 0;
  }

  .tech-marquee__item:hover :global(svg) {
    opacity: 1;
  }

  .tech-marquee__label {
    font-family: var(--font-body, 'Outfit', sans-serif);
    font-size: 1.75rem;
    font-weight: 400;
    color: var(--text-secondary);
    opacity: 0.4;
    transition: opacity 0.3s ease, color 0.3s ease;
  }

  .tech-marquee__item:hover .tech-marquee__label {
    opacity: 1;
    color: var(--text-primary);
  }

  .tech-marquee__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.2;
    flex-shrink: 0;
  }

  @keyframes tech-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 768px) {
    .tech-marquee {
      padding: 2rem 0;
    }

    .tech-marquee__group {
      gap: 2.5rem;
      padding-right: 2.5rem;
    }

    .tech-marquee__item :global(svg) {
      width: 64px;
      height: 64px;
    }

    .tech-marquee__label {
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech-marquee__track {
      animation: none;
    }
  }
</style>
