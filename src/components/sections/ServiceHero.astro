---
import PageHero from './PageHero.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Button from '../ui/Button.astro';

interface Props {
  title: string;
  tagline?: string;
  excerpt?: string;
  heroImageUrl?: string;
  slug?: string;
}

const { title, tagline, excerpt, heroImageUrl, slug } = Astro.props;
const description = excerpt || tagline;
---

<PageHero
  image={heroImageUrl}
  variant="inner"
  imageTransitionName={slug ? `service-hero-${slug}` : undefined}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Services', href: '/services/' },
    { name: title },
  ]}
>
  <SectionLabel text="Service" />

  <h1 style={slug ? `view-transition-name: service-title-${slug}` : undefined}>{title}</h1>

  {description && (
    <p class="page-hero__description">{description}</p>
  )}

  <div class="page-hero__actions">
    <Button href="/contact/" variant="primary" data-cta="service_cta" data-service={slug} data-location="service_hero" data-label="Discuss Your Project">Discuss Your Project</Button>
    <Button href="/services/" variant="text">All Services</Button>
  </div>
</PageHero>

