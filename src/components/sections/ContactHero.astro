---
import PageHero from './PageHero.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import HighlightedText from '../ui/HighlightedText.astro';

interface Props {
  label?: string;
  headline?: string;
  description?: string;
  image?: string;
}

const {
  label = "Get In Touch",
  headline = "Let's Build Something *Great*",
  description = "Tell us where manual work or disconnected systems slow your team down. We'll help you plan the right next step.",
  image,
} = Astro.props;
---

<PageHero
  variant="inner"
  image={image}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Contact' },
  ]}
>
  <SectionLabel text={label} />

  <h1>
    <HighlightedText text={headline} />
  </h1>

  <p class="page-hero__description">{description}</p>
</PageHero>
